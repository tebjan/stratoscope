<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows app: taskbar readout, notification-area icon and the panel. WinForms and GDI+ on .NET 10 (Windows 10 1809 and newer).
       The framework pieces (System.Text.Json, HttpClient, System.Drawing, WinForms, UI Automation, the registry) need no package.
       Publish self-contained (nothing to install: one compressed file, the smallest of the options WinForms supports) or framework-dependent
       (needs the .NET 10 Desktop Runtime): scripts/windows/build.ps1. WinForms cannot be trimmed (NETSDK1175) and ReadyToRun makes the
       compressed single file larger and slower to start, so neither is on. -->
  <PropertyGroup>
    <!-- Windows 10 version 1809, the oldest release the app supports; the version also gives access to the Windows Runtime APIs. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Stratoscope.Windows</RootNamespace>
    <AssemblyName>Stratoscope</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The Win32 declarations generated by CsWin32 use pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- UI Automation (System.Windows.Automation) lives in the WPF part of the Windows Desktop framework. No WPF window is created. -->
    <UseWPF>true</UseWPF>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>App\stratoscope.ico</ApplicationIcon>
    <ApplicationManifest>App\app.manifest</ApplicationManifest>
    <!-- The projects sit next to the solution and their code in the folders App, Core and Tools: each project lists its own folder. -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <AssemblyTitle>Stratoscope</AssemblyTitle>
    <Description>A live gauge for local LLM engines, in the Windows taskbar and notification area.</Description>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="App\**\*.cs" />
    <AdditionalFiles Include="App\NativeMethods.txt" />
    <AdditionalFiles Include="App\NativeMethods.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="StratoscopeWindowsCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="StratoscopeWindowsTests" />
    <InternalsVisibleTo Include="StratoscopeTools" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generates the Win32 declarations listed in NativeMethods.txt at build time; nothing of it ships. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.369" PrivateAssets="all" />
  </ItemGroup>
</Project>
