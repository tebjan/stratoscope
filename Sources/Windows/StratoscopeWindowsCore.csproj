<Project Sdk="Microsoft.NET.Sdk">
  <!-- The engine-neutral model, configuration, formatting and engine adapters. No WinForms, no System.Drawing: it runs anywhere .NET 10 does.
       JSON is System.Text.Json, part of the runtime: nothing to ship next to the exe. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Stratoscope.Core</RootNamespace>
    <AssemblyName>StratoscopeWindowsCore</AssemblyName>
    <!-- Trim and Native AOT compatible: the trim and AOT analyzers run on every build and their warnings are errors. -->
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- The projects sit next to the solution and their code in the folders App, Core and Tools: each project lists its own folder. -->
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Core\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="StratoscopeWindowsTests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
  </ItemGroup>
</Project>
