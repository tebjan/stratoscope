<Project Sdk="Microsoft.NET.Sdk">
  <!-- The development tools of the Windows app: the docs images rendered from the demo engine, the design measurements and the offscreen traces.
       They need the internals of the app and are not part of the release. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Stratoscope.Windows</RootNamespace>
    <AssemblyName>StratoscopeTools</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>App\app.manifest</ApplicationManifest>
    <!-- The projects sit next to the solution and their code in the folders App, Core and Tools: each project lists its own folder. -->
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Tools\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="StratoscopeWindowsCore.csproj" />
    <ProjectReference Include="StratoscopeWindows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="StratoscopeWindowsTests" />
  </ItemGroup>
</Project>
